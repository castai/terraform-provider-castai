    "id": "broadened-wildcard-custom-role",
    "name": "Broadened wildcard custom role",
    "description": "One custom role that trades the advertised fine-grained patterns for four service-wide wildcards, plus the exact authorization reads and managed-identity assignment, assigned to the three resource groups.",
    "rationale": "Every advertised pattern is matched by one of the broader wildcards (for example Microsoft.Compute/* matches Microsoft.Compute/*/read and every compute write), so coverage is a strict superset.",
    "expected_valid": true,
    "required_scope_coverage": [
      "cluster_resource_group",
      "node_resource_group",
      "vnet_resource_group"
    ],
    "role_definitions": [
      {
        "ref": "custom-broad-role",
        "kind": "custom",
        "name": "CastAI-AKS-Broad-<cluster_name>",
        "actions": [
          "Microsoft.Compute/*",
          "Microsoft.Network/*",
          "Microsoft.ContainerService/*",
          "Microsoft.Resources/*",
          "Microsoft.Authorization/locks/read",
          "Microsoft.Authorization/roleAssignments/read",
          "Microsoft.Authorization/roleDefinitions/read",
          "Microsoft.ManagedIdentity/userAssignedIdentities/assign/action"
        ],
        "not_actions": [],
        "assignable_scopes": [
          "cluster_resource_group",
          "node_resource_group",
          "vnet_resource_group"
        ]
      }
    ],
    "role_assignments": [
      {
        "role_definition": "custom-broad-role",
        "scope": "cluster_resource_group"
      },
      {
        "role_definition": "custom-broad-role",
        "scope": "node_resource_group"
      },
      {
        "role_definition": "custom-broad-role",
        "scope": "vnet_resource_group"
      }
    ]
  },
