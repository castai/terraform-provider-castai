  {
    "id": "builtin-roles-mix-with-gapfiller",
    "name": "Built-in roles mix with gap-filler custom role",
    "description": "Reader at subscription scope; Network Contributor, Azure Kubernetes Service Contributor Role and Virtual Machine Contributor at the three resource groups; plus a small custom gap-filler role for the advertised actions the built-ins do not cover (disk SAS access, gallery and snapshot writes, tag writes, managed identity assignment).",
    "rationale": "Each built-in covers the advertised patterns of its service, Reader covers every read, and the gap-filler closes the remaining advertised actions; unions at each scope cover the full list.",
    "expected_valid": true,
    "required_scope_coverage": [
      "cluster_resource_group",
      "node_resource_group",
      "vnet_resource_group"
    ],
    "role_definitions": [
      {
